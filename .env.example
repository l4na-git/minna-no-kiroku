# Docker Compose 用。コピーした .env は秘密情報を含むため公開しない。
# Cloudflare Zero Trust のチームドメイン（末尾の / は付けない）
CF_ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
# Access アプリケーションの Application Audience (AUD)
CF_ACCESS_AUD=
# Tunnel に設定した公開 URL（末尾の / は付けない）
APP_ORIGIN=https://records.example.com
# リモート管理 Tunnel のトークン
TUNNEL_TOKEN=
TZ=Asia/Tokyo

# ローカル開発時は npm run dev の前に AUTH_MODE=development を指定する。
# Docker / 本番ビルドでは開発用認証は利用できない。
